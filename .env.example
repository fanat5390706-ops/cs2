# Скопируйте в .env и замените change-me своими значениями. Файл .env не публикуйте.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DB_NAME=cs2_tournaments
DB_USER=cs2_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Внешние API ---------------------------------------------------------
# PandaScore: основной источник (https://app.pandascore.co/dashboard/main)
#   python manage.py import_pandascore
PANDASCORE_TOKEN=change-me

# Steam Web API (https://steamcommunity.com/dev/apikey)
#   python manage.py sync_steam / import_steam_ids
STEAM_API_KEY=change-me

# FACEIT Data API, ключ типа Server side (https://developers.faceit.com, раздел App Studio)
#   python manage.py sync_faceit
FACEIT_API_KEY=change-me

# Liquipedia: ключ не нужен, но правила API требуют контакт в User-Agent (email или адрес сайта)
#   python manage.py sync_liquipedia
LIQUIPEDIA_CONTACT=change-me

# Twitch (https://dev.twitch.tv/console, Register Your Application) — этап 4
TWITCH_CLIENT_ID=change-me
TWITCH_CLIENT_SECRET=change-me

# YouTube Data API v3 (https://console.cloud.google.com, Credentials) — этап 4
YOUTUBE_API_KEY=change-me

# NewsAPI (https://newsapi.org) — этап 4
NEWSAPI_KEY=change-me

# 1 — вместе с `runserver` в фоне обновляются матчи, рейтинг, новости и т.д. (отдельный run_workers не нужен)
AUTO_WORKERS=1

# Каналы Twitch для блока Top streams, пока нет ключей Twitch API (через запятую)
TWITCH_FALLBACK_CHANNELS=esl_csgo,blastpremier
